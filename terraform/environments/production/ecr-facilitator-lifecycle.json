{
  "rules": [
    {
      "rulePriority": 1,
      "description": "Rollback anchors (stable-*): never expired; tagged by scripts/ecr_rollback_anchors.py --tag",
      "selection": {
        "tagStatus": "tagged",
        "tagPrefixList": ["stable-"],
        "countType": "imageCountMoreThan",
        "countNumber": 9999
      },
      "action": { "type": "expire" }
    },
    {
      "rulePriority": 2,
      "description": "Untagged images older than 7 days",
      "selection": {
        "tagStatus": "untagged",
        "countType": "sinceImagePushed",
        "countUnit": "days",
        "countNumber": 7
      },
      "action": { "type": "expire" }
    },
    {
      "rulePriority": 3,
      "description": "Keep the 30 most recent of everything else",
      "selection": {
        "tagStatus": "any",
        "countType": "imageCountMoreThan",
        "countNumber": 30
      },
      "action": { "type": "expire" }
    }
  ]
}
